# API Base URL for Python Backend (e.g., FastAPI / Django backend)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Development / Demonstration Mock Mode:
# Set to 'true' to use rich demonstration manuscripts, OCR simulation, and research indexing
# Set to 'false' to communicate directly with your running Python backend
VITE_USE_MOCK_API=true
